// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String      @unique
  created_at            DateTime    @default(now()) @map("createdAt")
  email                 String?     @unique
  emailVerified         DateTime?
  image                 String?
  albums                Album[]
  images                Image[]
  customerId            String      @unique
  subscriptionId        String?     @unique
  isSubscriptionActive  Boolean     @default(false)
}

model Album {
  id          String    @id @default(cuid())
  created_at  DateTime  @default(now()) @map("createdAt")
  owner       User      @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  owner_id    String    @map("ownerId")
  name        String
  images      Image[]   
}

model Image {
  id          String      @id @default(cuid())
  created_at  DateTime    @default(now())
  url         String      @unique
  name        String
  size        Int
  album       Album       @relation(fields: [album_id], references: [id], onDelete: Cascade)
  album_id    String      @map("albumId")
  owner       User        @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  owner_id    String      @map("ownerId")
}