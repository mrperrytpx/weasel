{
    "name": "weasel",
    "version": "1.0.0",
    "description": "",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "ptypes": "pnpm --filter @weasel/db exec prisma generate",
        "studio": "pnpm --filter @weasel/db exec prisma studio",
        "migrate": "pnpm --filter @weasel/db exec prisma migrate dev",
        "build:db": "pnpm run ptypes && pnpm --filter @weasel/db run build",
        "build:schemas": "pnpm --filter @weasel/schemas run build",
        "client": "pnpm --filter @weasel/client run dev",
        "server": "pnpm --filter @weasel/server run dev",
        "build:server": "pnpm run ptypes && pnpm run build:db && pnpm run build:schemas && pnpm --filter @weasel/server run build",
        "build:client": "pnpm run ptypes && pnpm run build:schemas && pnpm --filter @weasel/client run build",
        "start:server": "pnpm --filter @weasel/server run start",
        "start:client": "pnpm --filter @weasel/client run start"
    },
    "keywords": [],
    "author": "",
    "license": "ISC"
}
